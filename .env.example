# --- Database ---------------------------------------------------------------
# Local dev default matches docker-compose.yml. Swap for a hosted Postgres
# (Neon, Supabase, Vercel Postgres via Marketplace, RDS) in staging/prod.
DATABASE_URL="postgresql://onion3d:onion3d_dev@localhost:5442/onion3d?schema=public"

# --- Auth.js ------------------------------------------------------------------
AUTH_SECRET="replace-with-a-32-byte-random-string" # `openssl rand -base64 32`
AUTH_URL="http://localhost:3000"

# Optional OAuth providers (leave unset to run email/password only)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Object storage (S3-compatible) -------------------------------------------
# Local dev default points at the MinIO container in docker-compose.yml.
# Swap for Vercel Blob / AWS S3 / Cloudflare R2 in production — the storage
# layer in src/lib/storage is provider-agnostic behind a single interface.
STORAGE_ENDPOINT="http://localhost:9020"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="onion3d"
STORAGE_SECRET_ACCESS_KEY="onion3d_dev_secret"
STORAGE_BUCKET="onion3d-assets"
STORAGE_PUBLIC_BASE_URL="http://localhost:9020/onion3d-assets"
STORAGE_FORCE_PATH_STYLE="true"

# --- Payments ------------------------------------------------------------------
# Provider abstraction lives in src/lib/payments. "mock" requires no keys and
# is the default for local development — it never touches a real gateway.
PAYMENT_PROVIDER="mock"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

PAYSTACK_SECRET_KEY=""

FLUTTERWAVE_SECRET_KEY=""

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
